# LLM Provider: bedrock (AWS) or ollama (local)
LLM_PROVIDER=bedrock

# AWS Bedrock Configuration (used if LLM_PROVIDER=bedrock)
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_DEFAULT_REGION=us-west-2

# Ollama Configuration (used if LLM_PROVIDER=ollama)
# Make sure Ollama is running: ollama serve
# Download a model first: ollama pull mistral (or llama2, neural-chat, etc.)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral
# Local inference can be slow; increase if you see read timeouts (seconds)
OLLAMA_TIMEOUT=600

# Optional: Override config.yaml values
# GEPA_LLM_BUDGET_HARD_CAP_USD=100.0
# GEPA_DATASET_TOTAL=200
